# PC Supervisor settings (docs/spec.md §4.1). Copy to pcs.conf (git-ignored),
# keep it outside this repo, and fill in. Every key can also come from the
# environment, which wins. Policy choices are NOT settings: they are readings
# in the answers file (PCS_ANSWERS). The app validates everything at startup
# and lists every problem at once.

# --- HotCRP instance -------------------------------------------------------
# Base URL of the conference (no trailing slash, no /api).
PCS_HOTCRP_URL=https://example.hotcrp.com
# The chair API token lives in the OS keychain (the app asks on first run).
# PCS_HOTCRP_TOKEN is read from the environment only for a localhost URL (tests, CI).
# false = respect the chair's own conflicts (hide those papers).
PCS_FORCE_SHOW=true

# The app lists every <id>.conf in this directory as a conference, each with its own
# encrypted store and keychain entries. Read from the environment only (it says where
# conference files are, so it can't live in one). Default: <OS app data>/conferences.
# PCS_CONFERENCES=

# --- Policy -------------------------------------------------------------------
# The answers file: one "Qn = <reading>" line per settled question (model format).
PCS_ANSWERS=

# --- Phase dates (ISO 8601, interpreted in PCS_TZ) ---------------------------
PCS_TZ=America/New_York
PCS_PHASE_REVIEW_DUE=2027-01-15T23:59
PCS_PHASE_RESPONSE_OPEN=
PCS_PHASE_RESPONSE_CLOSE=
PCS_PHASE_DISCUSSION_OPEN=2027-01-22T00:00
PCS_PHASE_DISCUSSION_CLOSE=2027-02-05T23:59
PCS_PHASE_DECISIONS_DUE=2027-02-07T23:59
# The other phase dates (spec §10.1), all optional; a date left out is skipped, not defaulted.
# A deadline closes its phase at that instant. EARLYREJECT and RESPONSE are windows: open at
# _OPEN, closed from _CLOSE.
# PCS_PHASE_REGISTRATION_DUE=
# PCS_PHASE_SUBMISSION_DUE=
# PCS_PHASE_DESKREJECT_DUE=
# PCS_PHASE_APPOINTMENTS_DUE=
# PCS_PHASE_ASSIGNMENT_DONE=
# PCS_PHASE_EARLYREJECT_OPEN=
# PCS_PHASE_EARLYREJECT_CLOSE=
# Q16's last-word window, when _EARLYREJECT_CLOSE is not set: hours after _EARLYREJECT_OPEN (default 48).
# PCS_EARLYREJECT_WINDOW_H=48
# --- Imports (spec §10.3) -----------------------------------------------------
# Days after which an import of a kind is reported stale (`pcs import status`). Defaults:
# appointments 7, tpms-registrations 14, tpms-assignments 30, tpms-scores 30, screening-bundle 3, refcheck 7.
# PCS_IMPORT_FRESH_APPOINTMENTS_DAYS=7
# PCS_IMPORT_FRESH_TPMS_REGISTRATIONS_DAYS=14
# PCS_IMPORT_FRESH_TPMS_ASSIGNMENTS_DAYS=30
# PCS_IMPORT_FRESH_TPMS_SCORES_DAYS=30
# PCS_IMPORT_FRESH_SCREENING_BUNDLE_DAYS=3
# PCS_IMPORT_FRESH_REFCHECK_DAYS=7
# Pin "now" (tests, or replaying a past state). Unset = real clock.
PCS_NOW=

# --- Roles and review form ---------------------------------------------------
# Who counts as a paper's area chair: meta | lead | manager | tag:<tag>
PCS_AC_ROLE=meta
# Reviewer tiers from PC user tags; untagged reviewers are "senior".
PCS_TIER_TAGS=junior=junior,nominee=nominee
# Review-form field UIDs (check with `pcs probe` against the real instance).
PCS_FIELD_MERIT=OveMer
PCS_FIELD_EXPERTISE=RevExp
PCS_MERIT_ACCEPT_MIN=3
PCS_EXPERTISE_OK_MIN=3
PCS_REVIEWS_REQUIRED=3
# How the overall-merit values read on the model's scale, for Q15 (what counts as a negative review):
# <merit>:<score> pairs; scores are strong-reject, reject, weak-reject, borderline, weak-accept, accept, strong-accept.
# Default is HotCRP's own Overall merit form.
# PCS_SCORE_MAP=1:reject,2:weak-reject,3:weak-accept,4:accept,5:strong-accept

# --- Venue numbers the model takes (owner's rulings, 2026-11-15) ----------------
# Q8 "up to n": the most nominees a paper may name (default 3).
# PCS_NOMINEES_MAX=3
# Q9: a nomination pattern shows once a senior has made this many nominations, repeats of one junior included (default 3).
# PCS_PATTERN_MIN=3
# AR5: hours after a request's due date before "no reply" may be recorded (default 48).
# PCS_ACC_GRACE_H=48

# --- Rule thresholds and weights (defaults in core; override any) -----------
# PCS_THRESH_SPLIT_RANGE=2
# PCS_THRESH_STALE_DAYS=4
# PCS_THRESH_UNRESOLVED_DAYS=5
# PCS_THRESH_PING_DAYS=3
# PCS_THRESH_MIN_WORDS=150
# PCS_THRESH_COACH_PAPERS=2   (negative rating flags on this many papers make a coaching case)
# PCS_THRESH_DEADLINE_DAYS=3
# PCS_RULE_SPLIT_WEIGHT=3   (etc. for every rule NAME in docs/spec.md §5c)

# --- Local store ---------------------------------------------------------------
# Default: the OS app-data directory, <conference id>.db for the app (the conference
# file's name) and <hotcrp-host>.db for the CLI. Keep it OUT of the
# repo and out of any synced folder. The SQLCipher key lives in the OS keychain.
PCS_DB_PATH=

# --- Assignment (spec §10.5) ----------------------------------------------------
# Reciprocal rings of up to this many papers are repaired (default 3).
# PCS_CYCLE_MAX_K=3
# Repair repeats until no such ring remains; this is the safety cap on the rounds (default 10).
# What is left after the cap is reported, never silent (A3).
# PCS_CYCLE_REPAIR_MAX_ROUNDS=10
# Conflict-engineering monitor (M3). A reviewer is "qualified" for a paper at this affinity or above (default 50) ...
# PCS_M3_AFFINITY_MIN=50
# ... and an author is flagged when they excluded at least this many qualified reviewers (default 3),
# PCS_M3_MIN_EXCLUDED=3
# at least this share of the qualified (default 0.5),
# PCS_M3_MIN_SHARE=0.5
# and more than the mean plus this many standard deviations across authors (default 2).
# PCS_M3_SIGMA=2
# PCS_SOLVER_TOPK=25
# PCS_SOLVER_HARD=0

# --- Load bands (reviews per person, per tier) ----------------------------------
# PCS_LOAD_SENIOR_MAX=15
# PCS_LOAD_JUNIOR_MAX=8

# --- Sync ------------------------------------------------------------------------
PCS_SYNC_INTERVAL_MIN=15
PCS_SYNC_CHUNK=200
PCS_SYNC_CONCURRENCY=2
PCS_HISTORY_RPS=1

# --- HotCRP conventions (docs/spec.md §11) ---------------------------------------
# PCS_TAG_TRIAGE_KEEP=pcs-keep
# PCS_TAG_TRIAGE_REFER=pcs-refer
# PCS_TAG_REQUEST=pcs-req
# The tag a chair puts on a filtered set that needs the chairs' attention (Writeback, spec §6).
PCS_TAG_CHAIR_ATTENTION=chair-attention

# --- Screening agent: inference engines (docs/agent.md §4.3, §5) -------------------
# Engines are declared entirely here; no model id is hard-coded and no credential is stored here.
# An engine's CLEARANCE is the highest data class it may receive; the dispatcher refuses any
# call above it before any I/O. confidential needs CLEARANCE_DECISION naming a settled decision.
# A claude-code engine defaults to public (a personal login is a development credential).
# PCS_ENGINES=dev,ci,selfhost-a
# PCS_ENGINE_dev_ADAPTER=claude-code
# PCS_ENGINE_dev_MODEL=<model id>
# PCS_ENGINE_dev_COMMAND=claude
# PCS_ENGINE_ci_ADAPTER=replay
# PCS_ENGINE_ci_REPLAY_OF=dev                 # serve recordings made as engine `dev`
# PCS_ENGINE_ci_RECORDINGS=agent/build/recordings
# PCS_ENGINE_ci_CLEARANCE=synthetic
# PCS_ENGINE_api_ADAPTER=anthropic
# PCS_ENGINE_api_PLATFORM=api                 # api | bedrock | vertex | foundry
# PCS_ENGINE_api_MODEL=<model id>
# PCS_ENGINE_api_REGION=<region>              # bedrock, vertex
# PCS_ENGINE_api_PROJECT=<project>            # vertex
# PCS_ENGINE_api_RESOURCE=<resource>          # foundry
# PCS_ENGINE_api_BASE_URL=<url>               # optional; the only host this engine may reach
# PCS_ENGINE_api_API_KEY_ENV=<VAR>            # name of the env var holding the key, if not the SDK default
# PCS_ENGINE_selfhost-a_ADAPTER=openai-compat
# PCS_ENGINE_selfhost-a_BASE_URL=http://gpu.example.org:8000/v1
# PCS_ENGINE_selfhost-a_MODEL=<model id>
# PCS_ENGINE_selfhost-a_STRUCTURED=json_schema   # json_schema | guided | tool | prompt
# PCS_ENGINE_<id>_CLEARANCE=synthetic|public|confidential
# PCS_ENGINE_<id>_CLEARANCE_DECISION=<decision id>
# PCS_ENGINE_<id>_PRICE_IN=0                  # USD per 1M tokens; also _PRICE_OUT, _PRICE_CACHE_READ, _PRICE_CACHE_WRITE
# PCS_ENGINE_<id>_CONCURRENCY=4               # _RPM and _TPM are read but not yet enforced
# PCS_ENGINE_<id>_GPU_HOUR_USD=2.0            # self-hosted: USD per GPU hour, spread over CONCURRENCY and added to the shootout's per-call cost
# PCS_CHECK_<check>_ENGINE=<engine id>        # production routing (set from the shootout)
# PCS_AGENT_SCALE_PAPERS=4000                 # instance size for the shootout's cost and wall-time projections (default 4000)
# PCS_AGENT_DECISIONS=/path/to/decisions.yaml   # the decision file (agent.md §3.1); venue-specific, kept outside the repo (agent/decisions.example.yaml is a synthetic example)
# PCS_AGENT_CFP=/path/to/cfp.txt                # the call for papers' topic text, for the scope check
# PCS_AGENT_CHECKS=agent/checks                 # the check directories (default agent/checks)
# PCS_AGENT_QUALIFICATIONS=/path/to/quals.json  # qualification records (agent.md 7.4): shown in the manifest, and the gate that refuses confidential data to an unqualified check and engine
# PCS_AGENT_STORE=/path/to/agent-store           # the content-addressed result store (agent.md 4.4)
# PCS_AGENT_STORE_KEY_FILE=/path/to/store.key    # a 32-byte URL-safe base64 key: the store is then encrypted (required for confidential papers); never in git
# PCS_AGENT_EGRESS=doi.org,api.crossref.org,api.openalex.org,export.arxiv.org,arxiv.org   # reference resolver allowlist

# Accountability requests (spec §10.4 D): the PC chairs' criteria list. A request cites criteria from this list and nothing else.
# The bracket names the heuristic signals the criterion answers (thin, rated, negative-no-weakness, outlier, empty-field, late).
PCS_CRITERION_1=Summarizes the contribution in the reviewer's own words
PCS_CRITERION_2=Backs each weakness with evidence [negative-no-weakness,thin]
PCS_CRITERION_3=Tells the authors what would change the reviewer's mind [thin,rated,outlier]
PCS_CRITERION_4=Submitted on time [late]
# PCS_REQUEST_DUE_H=48
# PCS_FIELD_WEAKNESS=
# PCS_FIELDS_REQUIRED=PapSum
