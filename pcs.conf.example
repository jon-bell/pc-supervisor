# PC Supervisor settings (docs/spec.md §4.1). Copy to pcs.conf (git-ignored),
# keep it outside this repo, and fill in. Every key can also come from the
# environment, which wins. Policy choices are NOT settings: they are readings
# in the answers file (PCS_ANSWERS). The app validates everything at startup
# and lists every problem at once.

# --- HotCRP instance -------------------------------------------------------
# Base URL of the conference (no trailing slash, no /api).
PCS_HOTCRP_URL=https://example.hotcrp.com
# The chair API token lives in the OS keychain (the app asks on first run).
# PCS_HOTCRP_TOKEN is read from the environment only for a localhost URL (tests, CI).
# false = respect the chair's own conflicts (hide those papers).
PCS_FORCE_SHOW=true

# The app lists every <id>.conf in this directory as a conference, each with its own
# encrypted store and keychain entries. Read from the environment only (it says where
# conference files are, so it can't live in one). Default: <OS app data>/conferences.
# PCS_CONFERENCES=

# --- Policy -------------------------------------------------------------------
# The answers file: one "Qn = <reading>" line per settled question (model format).
PCS_ANSWERS=

# --- Phase dates (ISO 8601, interpreted in PCS_TZ) ---------------------------
PCS_TZ=America/New_York
PCS_PHASE_REVIEW_DUE=2027-01-15T23:59
PCS_PHASE_RESPONSE_OPEN=
PCS_PHASE_RESPONSE_CLOSE=
PCS_PHASE_DISCUSSION_OPEN=2027-01-22T00:00
PCS_PHASE_DISCUSSION_CLOSE=2027-02-05T23:59
PCS_PHASE_DECISIONS_DUE=2027-02-07T23:59
# Pin "now" (tests, or replaying a past state). Unset = real clock.
PCS_NOW=

# --- Roles and review form ---------------------------------------------------
# Who counts as a paper's area chair: meta | lead | manager | tag:<tag>
PCS_AC_ROLE=meta
# Reviewer tiers from PC user tags; untagged reviewers are "senior".
PCS_TIER_TAGS=junior=junior,nominee=nominee
# Review-form field UIDs (check with `pcs probe` against the real instance).
PCS_FIELD_MERIT=OveMer
PCS_FIELD_EXPERTISE=RevExp
PCS_MERIT_ACCEPT_MIN=3
PCS_EXPERTISE_OK_MIN=3
PCS_REVIEWS_REQUIRED=3

# --- Rule thresholds and weights (defaults in core; override any) -----------
# PCS_THRESH_SPLIT_RANGE=2
# PCS_THRESH_STALE_DAYS=4
# PCS_THRESH_UNRESOLVED_DAYS=5
# PCS_THRESH_PING_DAYS=3
# PCS_THRESH_MIN_WORDS=150
# PCS_THRESH_DEADLINE_DAYS=3
# PCS_RULE_SPLIT_WEIGHT=3   (etc. for every rule NAME in docs/spec.md §5c)

# --- Local store ---------------------------------------------------------------
# Default: the OS app-data directory, <conference id>.db for the app (the conference
# file's name) and <hotcrp-host>.db for the CLI. Keep it OUT of the
# repo and out of any synced folder. The SQLCipher key lives in the OS keychain.
PCS_DB_PATH=

# --- Load bands (reviews per person, per tier) ----------------------------------
# PCS_LOAD_SENIOR_MAX=15
# PCS_LOAD_JUNIOR_MAX=8

# --- Sync ------------------------------------------------------------------------
PCS_SYNC_INTERVAL_MIN=15
PCS_SYNC_CHUNK=200
PCS_SYNC_CONCURRENCY=2
PCS_HISTORY_RPS=1

# --- HotCRP conventions (docs/spec.md §11) ---------------------------------------
# PCS_TAG_TRIAGE_KEEP=pcs-keep
# PCS_TAG_TRIAGE_REFER=pcs-refer
# PCS_TAG_REQUEST=pcs-req
