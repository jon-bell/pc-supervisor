{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "anonymity.llm output",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "kind", "reason"],
        "properties": {
          "quote": { "type": "string", "minLength": 10, "maxLength": 300 },
          "page": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["own-prior-work", "identifying-link", "institution-or-place", "other"] },
          "reason": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
