{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "summary output",
  "type": "object",
  "additionalProperties": false,
  "required": ["contributions", "evaluation", "prior_work", "closest_cited_work"],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "quote"],
      "properties": {
        "text": { "type": "string", "maxLength": 400 },
        "quote": { "type": "string", "minLength": 10, "maxLength": 300 },
        "page": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "properties": {
    "contributions": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/item" } },
    "evaluation": { "type": "array", "maxItems": 1, "items": { "$ref": "#/$defs/item" } },
    "prior_work": { "type": "array", "maxItems": 1, "items": { "$ref": "#/$defs/item" } },
    "closest_cited_work": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "text", "quote"],
        "properties": {
          "ref": { "type": "string", "maxLength": 20 },
          "text": { "type": "string", "maxLength": 400 },
          "quote": { "type": "string", "minLength": 10, "maxLength": 300 },
          "page": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
