{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "refs.doi findings",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "check",
      "version",
      "severity",
      "vectors",
      "message",
      "anchor"
    ],
    "properties": {
      "check": {
        "const": "refs.doi"
      },
      "version": {
        "type": "string"
      },
      "ground": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "format",
          "scope",
          "anonymity",
          "fabricated-reference",
          "misused-citation",
          "no-contribution",
          "nomination-noncompliance",
          "prompt-injection",
          null
        ]
      },
      "severity": {
        "enum": [
          "INFO",
          "LOW",
          "MEDIUM",
          "HIGH"
        ]
      },
      "vectors": {
        "type": "array",
        "minItems": 1,
        "items": {
          "enum": [
            "doi-not-found",
            "doi-mismatch",
            "title-not-found",
            "missing-doi",
            "unverified"
          ]
        }
      },
      "message": {
        "type": "string"
      },
      "quote": {
        "type": [
          "string",
          "null"
        ]
      },
      "anchor": {
        "type": "object",
        "properties": {
          "page": {
            "type": [
              "integer",
              "null"
            ]
          },
          "channel": {
            "type": [
              "string",
              "null"
            ]
          },
          "start": {
            "type": [
              "integer",
              "null"
            ]
          },
          "end": {
            "type": [
              "integer",
              "null"
            ]
          },
          "region": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "measured": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "detail": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
