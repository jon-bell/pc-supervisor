# Don't run dependencies' install scripts. Nothing here needs them: the
# SQLCipher driver (better-sqlite3-multiple-ciphers) ships prebuilt binaries
# for every platform, but because it also contains binding.gyp npm would
# otherwise run `node-gyp rebuild`, which fails on machines without a C
# toolchain (e.g. the ARC CI runners). Also shrinks the supply-chain surface.
# Explicit `npm run <script>` still works.
ignore-scripts=true
