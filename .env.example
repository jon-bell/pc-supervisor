# PC Supervisor configuration. Every setting is an env var; there is no config
# file. Copy to .env (git-ignored) and fill in. `pcs` loads ./.env itself (from
# the directory you run npm/npx in) only when PCS_HOTCRP_URL is not already set,
# and variables already in the environment win over the file. The server validates all of
# these at startup and lists every problem at once.

# --- HotCRP instance -------------------------------------------------------
# Base URL of the conference (no trailing slash, no /api).
PCS_HOTCRP_URL=https://example.hotcrp.com
# Chair (sysadmin) API token: Account settings > Developer. Never commit.
PCS_HOTCRP_TOKEN=
# false = respect the chair's own conflicts (hide those papers).
PCS_FORCE_SHOW=true
# Pin the whole app to the papers matching this HotCRP search, e.g. "#shadow"
# or "1-200" (empty = every paper). Every HotCRP read the sync and modules make
# is ANDed with it: "(<this>) AND (<their query>)". Papers that leave the
# search are marked gone at the next sync (kept, hidden everywhere) and come
# back if they match again. A search HotCRP warns about fails the sync.
PCS_PAPER_SEARCH=

# --- Phase dates (ISO 8601, interpreted in PCS_TZ) ---------------------------
# Format YYYY-MM-DDTHH:MM[:SS]; a time is required. An explicit offset
# (Z, -05:00) overrides PCS_TZ. Response dates: set both or neither.
PCS_TZ=America/New_York
PCS_PHASE_REVIEW_DUE=2027-01-15T23:59
PCS_PHASE_RESPONSE_OPEN=
PCS_PHASE_RESPONSE_CLOSE=
PCS_PHASE_DISCUSSION_OPEN=2027-01-22T00:00
PCS_PHASE_DISCUSSION_CLOSE=2027-02-05T23:59
PCS_PHASE_DECISIONS_DUE=2027-02-07T23:59
# Pin "now" (tests, or replaying a past state). Unset = real clock.
PCS_NOW=

# --- Extended phase model (docs/spec.md §10.1; large-conference modules) ---
# All optional; leave empty for the discussion MVP. Same format as above.
# Order (checked at startup; unset dates are skipped): REGISTRATION_DUE <=
# SUBMISSION_DUE <= QUICKREJECT_DUE <= ASSIGNMENT_DONE <= PCS_PHASE_REVIEW_DUE
# <= EARLYREJECT_OPEN <= EARLYREJECT_CLOSE <= RESPONSE_OPEN / DISCUSSION_OPEN.
# Abstract/reviewer registration deadline (reserve designees, module A).
PCS_PHASE_REGISTRATION_DUE=
# Full-paper submission deadline.
PCS_PHASE_SUBMISSION_DUE=
# Quick-reject review round due (module B).
PCS_PHASE_QUICKREJECT_DUE=
# TPMS assignment finalized in HotCRP (module C).
PCS_PHASE_ASSIGNMENT_DONE=
# Early-reject window (module E). CLOSE needs OPEN; with OPEN alone the window
# closes PCS_EARLYREJECT_WINDOW_H hours after it opens.
PCS_PHASE_EARLYREJECT_OPEN=
PCS_PHASE_EARLYREJECT_CLOSE=

# --- Roles and review form ---------------------------------------------------
# Who counts as a paper's area chair: meta | lead | manager | tag:<tag>
PCS_AC_ROLE=meta
# Reviewer tiers from PC user tags, as tier=tag pairs; untagged reviewers are
# "senior". Default: empty (everyone senior).
PCS_TIER_TAGS=junior=junior,reciprocal=reciprocal
# Review-form field UIDs (check with `pcs probe` against the real instance).
PCS_FIELD_MERIT=OveMer
PCS_FIELD_EXPERTISE=RevExp
PCS_MERIT_ACCEPT_MIN=3
PCS_EXPERTISE_OK_MIN=3
PCS_REVIEWS_REQUIRED=3

# --- Rule thresholds (docs/spec.md §5c) --------------------------------------
# Numbers; days may be fractional.
# Merit range (max - min) at or above which a paper is "split".
PCS_THRESH_SPLIT_RANGE=2
# Days without activity before a paper has "gone quiet" / is stale.
PCS_THRESH_STALE_DAYS=4
# Days of discussion with no score movement before a split is "unresolved".
PCS_THRESH_UNRESOLVED_DAYS=5
# Days before an @mention or AC comment counts as an unanswered ping.
PCS_THRESH_PING_DAYS=3
# Reviews shorter than this many words are "thin".
PCS_THRESH_MIN_WORDS=150
# Days before PCS_PHASE_DECISIONS_DUE when DEADLINE_NO_CONSENSUS can fire.
PCS_THRESH_DEADLINE_DAYS=3
# Raters (HotCRP review ratings) who must flag a review `short` (or `vague`)
# before THIN_REVIEWS counts it. Ratings are a multiset, so this is that
# flag's count on the review.
PCS_THRESH_RATING_RATERS=2
# Different papers on which a reviewer's reviews drew a negative rating flag
# (anything but `good`) before the reviewer is listed as repeatedly flagged.
PCS_THRESH_FLAGGED_PAPERS=2

# --- Rule weights (docs/spec.md §5c) -------------------------------------------
# A paper's severity is the sum of the weights of the rules it fires.
# 0 disables a rule.
PCS_RULE_MISSING_REVIEWS_WEIGHT=3
PCS_RULE_SPLIT_WEIGHT=3
PCS_RULE_UNRESOLVED_SPLIT_WEIGHT=2
PCS_RULE_SILENT_DISCUSSION_WEIGHT=3
PCS_RULE_GONE_QUIET_WEIGHT=2
PCS_RULE_AC_ABSENT_WEIGHT=2
PCS_RULE_CHAMPION_MISSING_WEIGHT=1
PCS_RULE_LOW_EXPERTISE_WEIGHT=2
PCS_RULE_THIN_REVIEWS_WEIGHT=1
PCS_RULE_RESPONSE_UNADDRESSED_WEIGHT=2
# A review rated `disrespectful` or `wrong`. Fires in any phase, and on
# decided papers too, so the chair can act before authors see the review.
PCS_RULE_REVIEW_FLAGGED_WEIGHT=4
PCS_RULE_DEADLINE_NO_CONSENSUS_WEIGHT=3
# Rule on/off switches (default true). Off = the rule is not evaluated,
# whatever its weight. These, the weights, the thresholds and
# PCS_MERIT_ACCEPT_MIN / PCS_EXPERTISE_OK_MIN / PCS_REVIEWS_REQUIRED are only
# the defaults: the chair can override them in the app (Rules page,
# `pcs rules set`); overrides live in the encrypted local DB, versioned.
# PCS_RULE_MISSING_REVIEWS_ENABLED=true
# PCS_RULE_SPLIT_ENABLED=true
# PCS_RULE_UNRESOLVED_SPLIT_ENABLED=true
# PCS_RULE_SILENT_DISCUSSION_ENABLED=true
# PCS_RULE_GONE_QUIET_ENABLED=true
# PCS_RULE_AC_ABSENT_ENABLED=true
# PCS_RULE_CHAMPION_MISSING_ENABLED=true
# PCS_RULE_LOW_EXPERTISE_ENABLED=true
# PCS_RULE_THIN_REVIEWS_ENABLED=true
# PCS_RULE_RESPONSE_UNADDRESSED_ENABLED=true
# PCS_RULE_REVIEW_FLAGGED_ENABLED=true
# PCS_RULE_DEADLINE_NO_CONSENSUS_ENABLED=true

# --- Assignment validator (docs/spec.md §10.4 C; `pcs validate-assignments`) ---
# Per paper: at least MIN_SENIOR senior reviews, plus a third slot filled by
# junior or reserve reviewers: exactly1 | atleast1.
PCS_POLICY_MIN_SENIOR=2
PCS_POLICY_THIRD_SLOT=exactly1
# Review-load bands per tier (review assignments per person, inclusive; ACs
# and chairs are exempt). Tiers come from PCS_TIER_TAGS, e.g.
# junior=junior,reserve-active=reserveactive,reserve-pool=reservepool;
# untagged PC members are senior. A designated-but-not-activated reserve
# (reserve-pool) should have no assignments, hence 0-0.
# These bands and MIN_SENIOR/THIRD_SLOT also feed `pcs export tpms` (spec
# §10.3): one load-<tier>.csv per tier and the reviews-per-paper target. The
# TPMS exchange needs no other variables.
PCS_LOAD_SENIOR_MIN=4
PCS_LOAD_SENIOR_MAX=12
PCS_LOAD_JUNIOR_MIN=2
PCS_LOAD_JUNIOR_MAX=8
PCS_LOAD_RESERVE_ACTIVE_MIN=1
PCS_LOAD_RESERVE_ACTIVE_MAX=3
PCS_LOAD_RESERVE_POOL_MIN=0
PCS_LOAD_RESERVE_POOL_MAX=0
# Reciprocal cycles (author of P -> reviewer of P): longest cycle searched
# (2-6), and how many cycles to list at most. Cycles are for human review only.
PCS_CYCLE_MAX_K=3
PCS_CYCLE_MAX_REPORT=500
# Conflict sanity: same affiliation between a reviewer and an author of the
# paper. DBLP co-authorship is optional and off; no lookup ships yet (no
# network calls).
PCS_CONFLICT_AFFILIATION=true
PCS_CONFLICT_DBLP=false

# --- Assignment solver (docs/spec.md §10.5; `pcs solve-assignments`) ------------
# Senior reviews a paper may get (a 4th review is possible); unset = PCS_POLICY_MIN_SENIOR.
PCS_POLICY_MAX_SENIOR=
# Required slots (MIN_SENIOR seniors + the third slot) are soft by default: each
# filled slot earns SLOT_BONUS, so the solve always succeeds and unmet slots are
# reported per paper. HARD=true makes them true lower bounds (can be infeasible).
PCS_SOLVER_HARD=false
PCS_SOLVER_SLOT_BONUS=100000
# Convex load cost: a reviewer's i-th assignment costs (i-1) x LOAD_COST, which
# spreads load within each band. Assignments up to the band minimum earn
# LOAD_MIN_BONUS (soft; underloads are reported).
PCS_SOLVER_LOAD_COST=20
PCS_SOLVER_LOAD_MIN_BONUS=10000
# Candidates kept per paper and tier class (senior / third slot), plus every
# pinned and current assignment.
PCS_SOLVER_TOPK=60
# Affinity: score 0-1 x source weight x SCALE, as an integer. Sources in
# priority order: the tpms-scores import, the affinity-local import, then
# HotCRP preferences/expertise/topic scores (get/allrevpref; W_HOTCRP=0 skips
# that call). A preference of +/-PREF_SCALE counts as full strength.
PCS_SOLVER_AFFINITY_SCALE=1000
PCS_SOLVER_W_TPMS=1
PCS_SOLVER_W_LOCAL=1
PCS_SOLVER_W_HOTCRP=0.5
PCS_SOLVER_PREF_SCALE=20
# Papers whose best candidate (per tier class) scores below this are reported as weakly covered.
PCS_SOLVER_WEAK_AFFINITY=0.3
# Repair passes: forbid-and-re-solve rounds at most (reciprocal cycles, and at
# most one reviewer per affiliation per paper when ONE_PER_INSTITUTION).
PCS_SOLVER_REPAIR_MAX=10
PCS_SOLVER_ONE_PER_INSTITUTION=true
# Review round written on new assignments in the bulk-assign CSV; empty = HotCRP's default round.
PCS_SOLVER_ROUND=

# --- Reserve compliance (spec §10.4 A, `pcs reserve`) --------------------------
# HotCRP submission-option names: the reserve designee (a text option holding
# the designee's email, or their name), the exemption claim (a dropdown), and
# an optional self-declared seniority note (shown as evidence, never judged).
PCS_RESERVE_DESIGNEE_FIELD="Reserve designee"
PCS_RESERVE_EXEMPTION_FIELD="Reserve exemption"
PCS_RESERVE_SENIORITY_FIELD="Reserve seniority"
# Exemption reasons that count (comma-separated, case-insensitive). Any other
# value of the exemption option is flagged EXEMPTION_NOT_ALLOWED.
PCS_RESERVE_EXEMPTIONS=no-eligible-author,all-authors-on-pc,other
# The reason that claims "every author is already on the PC"; it is checked
# against the PC roster (EXEMPTION_CONTRADICTED).
PCS_RESERVE_EXEMPTION_ALL_PC=all-authors-on-pc
# Flag a designee named by more than this many papers (coverage does not
# scale their obligation; it's a warning for the chair).
PCS_RESERVE_MAX_COVER=3
# With a tpms-registrations import: flag designees with fewer uploaded papers.
PCS_RESERVE_TPMS_MIN_PAPERS=1
# OPTIONAL DBLP lookup (off by default). When true, this is the ONE outbound
# call besides PCS_HOTCRP_URL (an opt-in exception to AGENTS.md rule 4 / spec
# §7): it sends only a public author name to PCS_DBLP_URL and counts that
# name's DBLP papers at PCS_DBLP_VENUES. Results are hints for a human, never
# verdicts (name matches can be wrong). PCS_DBLP_SENIOR_MIN papers at those
# venues makes the hint read "possibly senior"; PCS_DBLP_RPS caps requests/s.
PCS_DBLP_ENABLED=false
PCS_DBLP_URL=https://dblp.org
PCS_DBLP_VENUES="ICSE,ESEC/SIGSOFT FSE,SIGSOFT FSE,Proc. ACM Softw. Eng.,ASE,ISSTA"
PCS_DBLP_SENIOR_MIN=5
PCS_DBLP_RPS=1

# --- Quick-reject tracker (spec §10.4 B, `pcs quickreject`) --------------------
# The quick-reject review round, the review field holding the verdict (unset =
# PCS_FIELD_MERIT), and the highest value that counts as a "reject" vote.
PCS_QR_ROUND=quickreject
PCS_QR_FIELD=
PCS_QR_REJECT_MAX=1
# Paper tag an AC sets to flag a paper for quick reject.
PCS_QR_AC_FLAG_TAG=qr-flag
# State tags the chair/ACs set in HotCRP (the tool only reads them). Override
# any of: ac-reject, ac-keep, chair-desk-reject, chair-keep, appeal,
# appeal-upheld, appeal-overturned. Defaults: qr-<key>, e.g. qr-appeal.
PCS_QR_TAGS=
# HotCRP decisions that mean "rejected" (comma-separated).
PCS_QR_REJECT_DECISIONS=Rejected
# Leave quick-reject-round reviews out of the review slots (MISSING_REVIEWS,
# overview counts, assignment composition and load bands).
PCS_QR_EXCLUDE_FROM_SLOTS=true
# refcheck import signal: at least this many hallucinated references, or fewer
# than this many in-field references (1 = flag "no in-field references").
PCS_REFCHECK_HALLUCINATED_MIN=1
PCS_REFCHECK_IN_FIELD_MIN=1
# --- Reviewing by tier (docs/spec.md §10.4 D; `pcs tier-progress`) -----------
# Tiers (comma-separated PCS_TIER_TAGS names) shown in the reserve dropout and
# reserve accountability views.
PCS_RESERVE_TIERS=reserve-active,reciprocal
# Tiers whose thin or short/vague-rated reviews go in the coaching queue.
PCS_COACH_TIERS=junior
# Coaching depth floor in words. Empty = PCS_THRESH_MIN_WORDS.
PCS_COACH_MIN_WORDS=
# Days after PCS_PHASE_REVIEW_DUE after which a late reserve review is
# "replacement-needed" (fractional allowed).
PCS_RESERVE_DROPOUT_DAYS=3
# If the policy is adopted: list authors whose own papers' reviews would be
# withheld because their reserve reviews are late, and draft the HotCRP tag
# change (never applied by this tool). The tag is PCS_WITHHOLD_TAG.
PCS_POLICY_WITHHOLD_REVIEWS=false
PCS_WITHHOLD_TAG=reviews-withheld

# --- Early reject (docs/spec.md §10.4 E; `pcs early-reject`) -------------------
# Candidates: every submitted reviewer merit in the reject band.
#   reject_only          every merit <= PCS_MERIT_REJECT_MAX
#   include_weak_reject  every merit <= PCS_MERIT_WEAK_REJECT_MAX
PCS_POLICY_EARLYREJECT=reject_only
PCS_MERIT_REJECT_MAX=1
# Empty = PCS_MERIT_ACCEPT_MIN - 1.
PCS_MERIT_WEAK_REJECT_MAX=
# Submitted reviewer merits a candidate needs. Empty = PCS_REVIEWS_REQUIRED.
PCS_EARLYREJECT_MIN_REVIEWS=
# Hours reviewers get to re-read and bump (the drafted mail; also the window
# length when only PCS_PHASE_EARLYREJECT_OPEN is set).
PCS_EARLYREJECT_WINDOW_H=48

# --- Process report + pseudonymous export (spec §10.4 G) -------------------------
# Aggregate tables suppress any group (a tier, the reserve pool) with fewer than
# this many people, so no individual can be singled out; the pseudonymous export
# also writes such tiers as "other".
PCS_REPORT_MIN_CELL=5
# Decision names (case-insensitive prefixes, comma-separated) on the accept side;
# every other decision counts as reject. HotCRP's defaults are Accepted/Rejected.
PCS_REPORT_ACCEPT_DECISIONS=accept
# Chair-held HMAC-SHA256 key for the pseudonymous export (pcs export, the
# Report page's Export button). Required only for the export, which refuses to
# run without it. At least 16 characters, e.g. `openssl rand -hex 32`. Keep it
# secret and reuse it next year so pseudonyms join across conferences; never
# commit it.
PCS_PSEUDONYM_KEY=

# --- Local store ---------------------------------------------------------------
# Default: ~/.local/share/pc-supervisor/<hotcrp-host>.db. Keep it OUT of the
# repo and out of any synced folder.
PCS_DB_PATH=
# SQLCipher key. Required, except under NODE_ENV=test. (Reading it from the OS
# keychain is planned, not implemented.)
PCS_DB_KEY=

# --- Sync ------------------------------------------------------------------------
# Minutes between syncs; papers per reviews/comments request; requests in
# flight; /reviewhistory backfill requests per second. HotCRP's default rate
# limits are 250 requests/minute and 5000/hour per user.
PCS_SYNC_INTERVAL_MIN=15
PCS_SYNC_CHUNK=200
PCS_SYNC_CONCURRENCY=2
PCS_HISTORY_RPS=1

# --- Server ------------------------------------------------------------------------
# Local port; the server binds 127.0.0.1 only.
PCS_PORT=5317
# true = also accept tag changes from the Vite dev server's origin
# (http://127.0.0.1:5173). `npm run dev` sets it; leave it false otherwise.
PCS_DEV=false

# --- v1 actions (spec §6) --------------------------------------------------------
# Paper tag the "Tag for chair attention" action adds or removes, without the #.
# Every change is previewed with a HotCRP dry run and needs explicit confirmation.
PCS_ATTENTION_TAG=chair-attention
